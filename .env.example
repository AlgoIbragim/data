# Application Environment
# Options: development, production, demo
APP_ENV=demo

# Flask Configuration
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here

# HTTPS Configuration
# Set to true when running with HTTPS
HTTPS=false

# Teacher Invite Code
# Set a secure code for teacher registration
TEACHER_INVITE_CODE=your-secure-invite-code

# Database
# SQLite is used by default
DATABASE_PATH=data/infotrainer.db
